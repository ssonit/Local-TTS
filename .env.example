# Key chỉ nằm trên máy này. Không commit file .env.
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=dan_key_vao_day
# GEMINI_API_KEY_2=
# Lấy key tại https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=dan_key_vao_day
# DEEPSEEK_MODEL=deepseek-flash
# DeepSeek trên máy: repo Deepseek-API, không cần key.
# Chạy `python app.py` trong thư mục Deepseek-API trước khi dịch.
# DEEPSEEK_LOCAL_URL=http://127.0.0.1:8000/v1/chat/completions
# DEEPSEEK_LOCAL_MODEL=deepseek-chat
